package slots

import (
	"fmt"
	"strings"

	"github.com/my-pet-projects/collection/internal/model"
	"github.com/my-pet-projects/collection/internal/view/component/header"
	"github.com/my-pet-projects/collection/internal/view/component/icon"
	"github.com/my-pet-projects/collection/internal/view/layout"
)

templ Page(configs []model.CountrySlotConfig) {
	@layout.BaseLayout() {
		<div x-data="{ query: '' }">
			@header.PageHeaderSimple(
				"Slot settings",
				"Choose the collection prefix and sheet size used for each country",
				"settings",
			)
			<div class="mb-5 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-gray-200/70 sm:p-5">
				<label for="slot-config-search" class="mb-2 block text-sm font-medium text-gray-700">Find a country or prefix</label>
				<div class="relative">
					<div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400">
						@icon.SearchIcon("h-5 w-5")
					</div>
					<input
						id="slot-config-search"
						type="search"
						x-model.debounce.150ms="query"
						placeholder="Search countries, codes, or prefixes..."
						class="w-full rounded-xl border border-gray-300 bg-white py-2.5 pl-10 pr-4 text-sm shadow-sm transition focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-200"
					/>
				</div>
				<p class="mt-2 text-xs text-gray-500">{ fmt.Sprintf("%d countries configured", len(configs)) }</p>
			</div>
			<div class="overflow-hidden rounded-2xl bg-white shadow-xl ring-1 ring-gray-200/70">
				<div class="sm:overflow-x-auto">
					<table class="block min-w-full sm:table sm:divide-y sm:divide-gray-200">
						<thead class="hidden bg-gray-50 sm:table-header-group">
							<tr>
								<th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 sm:px-6">Country</th>
								<th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Prefix</th>
								<th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Rows</th>
								<th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-gray-500 sm:px-6">Action</th>
							</tr>
						</thead>
						<tbody class="block divide-y divide-gray-100 sm:table-row-group">
							for _, config := range configs {
								@ConfigRow(config, model.CountrySlotConfigErrors{})
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	}
}

templ ConfigRow(config model.CountrySlotConfig, errs model.CountrySlotConfigErrors) {
	{{ formID := "slot-config-" + strings.ToLower(config.CountryCode) }}
	<tr
		class="grid grid-cols-[minmax(0,1fr)_5rem_auto] gap-3 p-4 transition-colors hover:bg-amber-50/40 sm:table-row sm:p-0"
		data-search={ strings.ToLower(config.GetCountryName() + " " + config.CountryCode + " " + config.Prefix) }
		x-show="query === '' || $el.dataset.search.includes(query.toLowerCase())"
	>
		<td class="col-span-3 block whitespace-nowrap p-0 sm:table-cell sm:px-6 sm:py-3">
			<div class="font-medium text-gray-900">{ config.GetCountryName() }</div>
			<div class="text-xs font-semibold tracking-wide text-gray-400">{ config.CountryCode }</div>
		</td>
		<td class="block min-w-0 p-0 align-top sm:table-cell sm:min-w-44 sm:px-4 sm:py-3">
			<label for={ formID + "-prefix" } class="mb-1 block text-xs font-medium text-gray-500 sm:hidden">Prefix</label>
			<input
				id={ formID + "-prefix" }
				form={ formID }
				type="text"
				name="prefix"
				value={ config.Prefix }
				maxlength="20"
				required
				class={ "w-full rounded-lg border bg-white px-3 py-2 text-sm font-semibold uppercase shadow-sm focus:outline-none focus:ring-2",
					templ.KV("border-red-300 focus:border-red-500 focus:ring-red-200", errs.Prefix != ""),
					templ.KV("border-gray-300 focus:border-amber-500 focus:ring-amber-200", errs.Prefix == "") }
			/>
			if errs.Prefix != "" {
				<p class="mt-1 text-xs font-medium text-red-600">{ errs.Prefix }</p>
			}
		</td>
		<td class="block w-auto p-0 align-top sm:table-cell sm:w-28 sm:px-4 sm:py-3">
			<label for={ formID + "-rows" } class="mb-1 block text-xs font-medium text-gray-500 sm:hidden">Rows</label>
			<select
				id={ formID + "-rows" }
				form={ formID }
				name="rowsPerSheet"
				class={ "w-full rounded-lg border bg-white px-3 py-2 text-sm shadow-sm focus:outline-none focus:ring-2",
					templ.KV("border-red-300 focus:border-red-500 focus:ring-red-200", errs.RowsPerSheet != ""),
					templ.KV("border-gray-300 focus:border-amber-500 focus:ring-amber-200", errs.RowsPerSheet == "") }
			>
				<option value="5" selected?={ config.RowsPerSheet == 5 }>5</option>
				<option value="6" selected?={ config.RowsPerSheet == 6 }>6</option>
			</select>
			if errs.RowsPerSheet != "" {
				<p class="mt-1 text-xs font-medium text-red-600">{ errs.RowsPerSheet }</p>
			}
		</td>
		<td class="block p-0 pt-5 text-right align-top sm:table-cell sm:px-6 sm:py-3">
			<form
				id={ formID }
				hx-put={ fmt.Sprintf("/workspace/settings/slots/%s", config.CountryCode) }
				hx-target="closest tr"
				hx-swap="outerHTML"
				x-on:htmx:response-error="$dispatch('notify', { variant: 'danger', xhrResponse: $event.detail.xhr.response })"
			>
				<input type="hidden" name="countryName" value={ config.GetCountryName() }/>
				<button
					type="submit"
					class="inline-flex items-center gap-2 rounded-lg bg-gray-900 px-3 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-amber-600 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2"
				>
					@icon.SaveIcon("h-4 w-4")
					<span class="hidden sm:inline">Save</span>
				</button>
			</form>
		</td>
	</tr>
}
