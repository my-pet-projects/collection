package recognition

import (
	"fmt"

	recognitiondomain "github.com/my-pet-projects/collection/internal/recognition"
	"github.com/my-pet-projects/collection/internal/view/component/header"
	"github.com/my-pet-projects/collection/internal/view/layout"
)

type PageData struct {
	layout.Page
}

templ Page(page PageData) {
	@layout.BaseLayout() {
		@header.PageHeaderSimple("Recognize Beer", "Take a clear photo of the bottle or label", "images")
		<div class="mx-auto max-w-3xl space-y-6">
			<div
				class="overflow-hidden rounded-2xl bg-white p-4 shadow-xl ring-1 ring-gray-200/50 sm:p-6 lg:p-8"
				x-data="{ preview: '', fileName: '' }"
			>
				<form
					hx-post="/workspace/recognition/beer"
					hx-target="#recognition-result"
					hx-swap="innerHTML"
					hx-encoding="multipart/form-data"
					hx-indicator="#recognition-spinner"
					hx-disabled-elt="button,input"
					class="space-y-5"
				>
					<div x-show="preview" x-cloak class="space-y-3">
						<img :src="preview" alt="Selected beer label" class="mx-auto max-h-80 w-full rounded-xl bg-gray-50 object-contain ring-1 ring-gray-200"/>
						<div class="flex items-center justify-between gap-3">
							<p class="min-w-0 truncate text-sm text-gray-500" x-text="fileName"></p>
							<button
								type="button"
								@click="
									URL.revokeObjectURL(preview);
									preview = '';
									fileName = '';
									$refs.fileInput.value = '';
									document.getElementById('recognition-result').innerHTML = '';
								"
								class="shrink-0 rounded-lg px-3 py-2 text-sm font-medium text-gray-600 hover:bg-gray-100"
							>
								Choose another
							</button>
						</div>
					</div>
					<label
						x-show="!preview"
						class="flex cursor-pointer flex-col items-center justify-center rounded-xl border-2 border-dashed border-gray-300 bg-gray-50 px-4 py-10 text-center transition hover:border-amber-400 hover:bg-amber-50"
					>
						<svg class="mb-3 h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 0 1 5.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 0 0-1.134-.175 2.31 2.31 0 0 1-1.64-1.055l-.822-1.316a2.192 2.192 0 0 0-1.736-1.039 48.774 48.774 0 0 0-5.232 0 2.192 2.192 0 0 0-1.736 1.039l-.821 1.316Z"></path>
							<path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0Z"></path>
						</svg>
						<span class="text-sm font-semibold text-gray-700">Take a photo or choose an image</span>
						<span class="mt-1 text-xs text-gray-400">Image up to 10 MB</span>
						<input
							type="file"
							name="image"
							accept="image/*"
							capture="environment"
							required
							x-ref="fileInput"
							@change="
								const file = $event.target.files[0];
								if (file) {
									if (preview) URL.revokeObjectURL(preview);
									preview = URL.createObjectURL(file);
									fileName = file.name;
									document.getElementById('recognition-result').innerHTML = '';
								}
							"
							class="hidden"
						/>
					</label>
					<button
						type="submit"
						x-show="preview"
						class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-amber-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-amber-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 disabled:cursor-not-allowed disabled:opacity-50 sm:w-auto"
					>
						<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.847-.814a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.847.814a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.456-2.456L14.25 6l1.035-.259a3.375 3.375 0 0 0 2.456-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z"></path>
						</svg>
						Recognize label
					</button>
				</form>
				<div id="recognition-spinner" class="htmx-indicator mt-5">
					<div class="flex items-center gap-2 rounded-xl bg-amber-50 p-4 text-sm text-amber-800">
						<svg class="h-5 w-5 animate-spin" viewBox="0 0 24 24" fill="none">
							<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
							<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4Z"></path>
						</svg>
						Analyzing the label…
					</div>
				</div>
			</div>
			<div id="recognition-result" aria-live="polite"></div>
		</div>
	}
}

templ Result(result recognitiondomain.Result) {
	<div class="overflow-hidden rounded-2xl bg-white p-5 shadow-xl ring-1 ring-gray-200/50 sm:p-7">
		<div class="mb-5 flex flex-wrap items-center justify-between gap-3">
			<h2 class="text-xl font-semibold text-gray-900">Recognition result</h2>
			<span
				class={
					"rounded-full px-3 py-1 text-xs font-semibold",
					templ.KV("bg-green-100 text-green-800", result.Confidence >= 0.6),
					templ.KV("bg-amber-100 text-amber-800", result.Confidence < 0.6),
				}
			>
				{ fmt.Sprintf("%.0f%% confidence", result.Confidence * 100) }
			</span>
		</div>
		if result.Confidence < 0.6 {
			<p class="mb-5 rounded-xl bg-amber-50 p-3 text-sm text-amber-800">
				Confidence is low. Try another photo or verify every field carefully.
			</p>
		}
		<dl class="grid gap-4 sm:grid-cols-2">
			@ResultField("Beer name", result.BeerName)
			@ResultField("Brewery", result.Brewery)
			@ResultField("Type", result.BeerType)
			@ResultField("Style", result.Style)
			@ResultField("Model", result.Model)
		</dl>
		if result.Notes != "" {
			<div class="mt-5 rounded-xl bg-gray-50 p-4">
				<h3 class="text-xs font-semibold uppercase tracking-wide text-gray-500">Notes</h3>
				<p class="mt-1 text-sm leading-relaxed text-gray-700">{ result.Notes }</p>
			</div>
		}
		<p class="mt-5 text-xs text-gray-400">AI output can be incorrect. Verify the label before using these details.</p>
	</div>
}

templ ResultField(label, value string) {
	<div class="rounded-xl bg-gray-50 p-4 ring-1 ring-gray-100">
		<dt class="text-xs font-semibold uppercase tracking-wide text-gray-500">{ label }</dt>
		<dd class="wrap-anywhere mt-1 text-base font-medium text-gray-900">
			if value == "" {
				<span class="font-normal text-gray-400">Not identified</span>
			} else {
				{ value }
			}
		</dd>
	</div>
}

templ RecognitionError(message string) {
	<div class="rounded-2xl border border-red-200 bg-red-50 p-5 shadow-sm" role="alert">
		<h2 class="font-semibold text-red-900">Could not recognize the label</h2>
		<p class="mt-1 text-sm leading-relaxed text-red-700">{ message }</p>
	</div>
}
